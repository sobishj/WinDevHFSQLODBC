<UserControl
    x:Class="HfsqlOdbcStudio.Views.ExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:HfsqlOdbcStudio.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ExplorerViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ContextMenu x:Key="TableContextMenu" x:Shared="False">
            <MenuItem Command="{Binding SelectTop100Command}" Header="Select top 100">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding GenerateCreateCommand}" Header="Generate CREATE template">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="TableAdd24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding GenerateAlterCommand}" Header="Generate ALTER template">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="TableEdit24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding GenerateDropCommand}" Header="Generate DROP">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="TableDismiss24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding CopyNameCommand}" Header="Copy name">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <HierarchicalDataTemplate DataType="{x:Type vm:TableNodeViewModel}" ItemsSource="{Binding Children}">
            <Border
                Margin="-4,0,0,0"
                Padding="4,2,8,2"
                Background="Transparent"
                CornerRadius="4"
                ContextMenu="{StaticResource TableContextMenu}"
                ToolTip="{Binding Info.Type}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        FontSize="16"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Symbol="Table24" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                    <Border
                        Margin="8,0,0,0"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}"
                        CornerRadius="4"
                        Visibility="{Binding HasTypeBadge, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding TypeBadge}" />
                    </Border>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:ColumnNodeViewModel}">
            <StackPanel
                Margin="0,1"
                Orientation="Horizontal"
                ToolTip="{Binding ToolTip}">
                <ui:SymbolIcon
                    Margin="0,0,8,0"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="TextColumnOne24" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MonoFont}"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding TypeDisplay}" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding NullableDisplay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MessageNode}">
            <TextBlock
                FontStyle="Italic"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{Binding Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,16,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Explorer" />
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Summary}" />
            </StackPanel>
            <ui:Button
                Grid.Column="1"
                Width="32"
                Height="32"
                Padding="0"
                Appearance="Transparent"
                AutomationProperties.Name="Refresh tables"
                Command="{Binding RefreshCommand}"
                ToolTip="Refresh tables">
                <ui:SymbolIcon FontSize="16" Symbol="ArrowClockwise24" />
            </ui:Button>
        </Grid>

        <ui:TextBox
            Grid.Row="1"
            Margin="0,0,0,8"
            Icon="{ui:SymbolIcon Search24}"
            PlaceholderText="Search tables"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <Border
            Grid.Row="2"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <TreeView
                    x:Name="Tree"
                    Padding="4"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding TablesView}"
                    SelectedItemChanged="OnSelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <ProgressBar
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                <!--  Empty state  -->
                <StackPanel
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasEmptyMessage, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Symbol="DatabaseSearch24" />
                    <TextBox
                        HorizontalContentAlignment="Center"
                        FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource SelectableText}"
                        Text="{Binding EmptyMessage, Mode=OneWay}"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
