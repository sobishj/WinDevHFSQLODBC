<UserControl
    x:Class="HfsqlOdbcStudio.Views.DdlTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:HfsqlOdbcStudio.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:HfsqlOdbcStudio.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DdlTestViewModel}"
    d:DesignHeight="400"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type models:DdlTestStep}">
            <Border
                x:Name="Card"
                Margin="0,0,0,8"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Width="24"
                        Height="24"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top">
                        <ui:SymbolIcon
                            x:Name="StatusIcon"
                            FontSize="20"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="Circle24" />
                        <ui:ProgressRing
                            x:Name="RunningRing"
                            Width="18"
                            Height="18"
                            IsIndeterminate="True"
                            Visibility="Collapsed" />
                    </Grid>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold">
                        <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Title, Mode=OneWay}" />
                    </TextBlock>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="Elapsed"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding ElapsedMs, StringFormat={}{0:N0} ms}" />
                        <Border
                            x:Name="Badge"
                            Padding="8,2"
                            Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}"
                            CornerRadius="10">
                            <TextBlock
                                x:Name="BadgeText"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="PENDING" />
                        </Border>
                    </StackPanel>

                    <Border
                        x:Name="DetailBorder"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,0"
                        Padding="8"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVis}}">
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Detail, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DdlStepStatus.Pending}">
                    <Setter TargetName="Elapsed" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DdlStepStatus.Running}">
                    <Setter TargetName="StatusIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RunningRing" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BadgeText" Property="Text" Value="RUNNING" />
                    <Setter TargetName="Elapsed" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DdlStepStatus.Passed}">
                    <Setter TargetName="StatusIcon" Property="Symbol" Value="CheckmarkCircle24" />
                    <Setter TargetName="StatusIcon" Property="Filled" Value="True" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="PASSED" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DdlStepStatus.Failed}">
                    <Setter TargetName="StatusIcon" Property="Symbol" Value="DismissCircle24" />
                    <Setter TargetName="StatusIcon" Property="Filled" Value="True" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="FAILED" />
                    <Setter TargetName="DetailBorder" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DdlStepStatus.Skipped}">
                    <Setter TargetName="StatusIcon" Property="Symbol" Value="Warning24" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="NOT RUN" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource SectionTitle}">
                    <Run Text="DDL capability test on" />
                    <Run FontFamily="{StaticResource MonoFont}" Text="{Binding TableName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    Margin="0,4,0,0"
                    Text="{Binding Summary}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource CaptionText}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverallPassed}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OverallPassed}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding RunCommand}"
                    Content="Run test"
                    Icon="{ui:SymbolIcon Play24}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Danger"
                    Command="{Binding RunCancelCommand}"
                    Content="Cancel"
                    Icon="{ui:SymbolIcon Stop24}"
                    Visibility="{Binding RunCommand.IsRunning, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding ExportReportCommand}"
                    Content="Export report"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Copy report"
                    Command="{Binding CopyReportCommand}"
                    Icon="{ui:SymbolIcon Copy24}"
                    ToolTip="Copy report (Markdown)" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemTemplate="{StaticResource StepTemplate}" ItemsSource="{Binding Steps}" />
        </ScrollViewer>
    </Grid>
</UserControl>
