<ui:FluentWindow
    x:Class="HfsqlOdbcStudio.Views.ConnectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:HfsqlOdbcStudio.ViewModels"
    Title="Connection"
    Width="720"
    Height="820"
    MinWidth="560"
    MinHeight="520"
    d:DataContext="{d:DesignInstance Type=vm:ConnectionViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="HFSQL ODBC connection"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer
            Grid.Row="1"
            Padding="24,8,24,16"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  Profiles  -->
                <Border Margin="0,0,0,16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource SectionTitle}"
                            Text="Profile" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Saved profiles" />
                                <ComboBox
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Profiles}"
                                    SelectedItem="{Binding SelectedProfile}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Profile name" />
                                <ui:TextBox PlaceholderText="e.g. Production server" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding NewProfileCommand}"
                                Content="New"
                                Icon="{ui:SymbolIcon Add24}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding SaveProfileCommand}"
                                Content="Save"
                                Icon="{ui:SymbolIcon Save24}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding DeleteProfileCommand}"
                                Content="Delete"
                                Icon="{ui:SymbolIcon Delete24}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Mode  -->
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource SectionTitle}"
                    Text="Connect using" />
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                    <RadioButton
                        Margin="0,0,24,0"
                        Content="Server fields"
                        GroupName="Mode"
                        IsChecked="{Binding IsFieldsMode}" />
                    <RadioButton
                        Margin="0,0,24,0"
                        Content="Existing DSN (64-bit)"
                        GroupName="Mode"
                        IsChecked="{Binding IsDsnMode}" />
                    <RadioButton
                        Content="Connection string (advanced)"
                        GroupName="Mode"
                        IsChecked="{Binding IsRawMode}" />
                </StackPanel>

                <ui:InfoBar
                    Title="ODBC driver"
                    Margin="0,0,0,16"
                    IsClosable="False"
                    IsOpen="{Binding HasDriverWarning}"
                    Message="{Binding DriverWarning}"
                    Severity="Warning" />

                <!--  Mode (a): fields  -->
                <Border
                    Margin="0,0,0,16"
                    Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsFieldsMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ODBC driver (64-bit drivers only)" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                IsEditable="True"
                                ItemsSource="{Binding Drivers}"
                                Text="{Binding Driver, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                Width="36"
                                Height="34"
                                Margin="8,0,0,0"
                                Padding="0"
                                AutomationProperties.Name="Reload drivers and DSNs"
                                Command="{Binding RefreshDriversCommand}"
                                ToolTip="Reload drivers and DSNs from the registry">
                                <ui:SymbolIcon FontSize="16" Symbol="ArrowClockwise24" />
                            </ui:Button>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Database type" />
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <RadioButton
                                Margin="0,0,24,0"
                                Content="HFSQL Client/Server"
                                GroupName="HfKind"
                                IsChecked="{Binding IsClientServer}" />
                            <RadioButton
                                Content="HFSQL Classic (HyperFile)"
                                GroupName="HfKind"
                                IsChecked="{Binding IsClassic}" />
                        </StackPanel>

                        <!--  HFSQL Classic  -->
                        <StackPanel Visibility="{Binding IsClassic, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Data folder (REP) - folder that contains the .fic files" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox PlaceholderText="e.g. C:\MyApp\Data  or  \\server\share\Data" Text="{Binding ClassicDataDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseClassicDataDirectoryCommand}"
                                    Content="Browse…"
                                    Icon="{ui:SymbolIcon Folder24}" />
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Analysis file (ANA, .wdd) - optional" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox PlaceholderText="e.g. C:\My Projects\CRM\CRM.wdd" Text="{Binding ClassicAnalysisFile, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseClassicAnalysisFileCommand}"
                                    Content="Browse…"
                                    Icon="{ui:SymbolIcon DocumentSearch24}" />
                            </Grid>
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource CaptionText}"
                                Text="Connection string per PC SOFT: DRIVER={HFSQL};ANA=&lt;.wdd&gt;;REP=&lt;data folder&gt;. User name and password are not used for Classic." />
                        </StackPanel>

                        <!--  HFSQL Client/Server  -->
                        <StackPanel Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Server / host" />
                                <ui:TextBox PlaceholderText="localhost or 192.168.1.10" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                                <ui:TextBox ClearButtonEnabled="False" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Database" />
                        <ui:TextBox PlaceholderText="Database name on the HFSQL server" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Mode (b): DSN  -->
                <Border
                    Margin="0,0,0,16"
                    Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsDsnMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Data source (64-bit System and User DSNs)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Dsns}" SelectedItem="{Binding SelectedDsn}" />
                            <ui:Button
                                Grid.Column="1"
                                Width="36"
                                Height="34"
                                Margin="8,0,0,0"
                                Padding="0"
                                AutomationProperties.Name="Reload drivers and DSNs"
                                Command="{Binding RefreshDriversCommand}"
                                ToolTip="Reload drivers and DSNs from the registry">
                                <ui:SymbolIcon FontSize="16" Symbol="ArrowClockwise24" />
                            </ui:Button>
                        </Grid>
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource CaptionText}"
                            Text="No 64-bit DSN found. Create one with the 64-bit ODBC Data Source Administrator (odbcad32.exe in System32)."
                            Visibility="{Binding HasDsns, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </Border>

                <!--  Mode (c): raw  -->
                <Border
                    Margin="0,0,0,16"
                    Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsRawMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ODBC connection string" />
                        <TextBox
                            MinHeight="88"
                            AcceptsReturn="False"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="12"
                            Text="{Binding RawConnectionString, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource CaptionText}"
                            Text="Sent to the driver as-is. %USER% and %PASSWORD% are replaced by the credentials below, so the password does not have to be typed into the string. Keywords for HFSQL usually are: DRIVER={HFSQL};Server Name=…;Server Port=4900;Database=…;UID=…;PWD=…" />
                    </StackPanel>
                </Border>

                <!--  Credentials  -->
                <Border Margin="0,0,0,16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource SectionTitle}"
                            Text="Credentials" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="User name" />
                                <ui:TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PasswordInput" Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}}" />
                                    <ui:TextBox
                                        ClearButtonEnabled="False"
                                        Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />
                                    <ToggleButton
                                        Grid.Column="1"
                                        Width="36"
                                        Height="34"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        AutomationProperties.Name="Show password"
                                        IsChecked="{Binding IsPasswordVisible}"
                                        ToolTip="Show / hide password">
                                        <ui:SymbolIcon FontSize="16">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Eye24" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                            <Setter Property="Symbol" Value="EyeOff24" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </ToggleButton>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding CredentialsHint}" />
                    </StackPanel>
                </Border>

                <!--  Effective connection string  -->
                <Border Margin="0,0,0,16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionTitle}"
                                Text="Connection string (password masked)" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button
                                    Appearance="Transparent"
                                    Command="{Binding CopyConnectionStringCommand}"
                                    Content="Copy"
                                    Icon="{ui:SymbolIcon Copy24}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Appearance="Transparent"
                                    Command="{Binding EditAsRawCommand}"
                                    Content="Edit as connection string"
                                    Icon="{ui:SymbolIcon Edit24}"
                                    ToolTip="Switch to raw mode with this string (credentials as %USER% / %PASSWORD%)"
                                    Visibility="{Binding IsRawMode, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Grid>
                        <Border
                            Padding="8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding EffectiveConnectionString, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Data file folder  -->
                <Border Margin="0,0,0,16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource SectionTitle}"
                            Text="Data file folder (HFSQL database folder)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox PlaceholderText="e.g. C:\HVW4HFCS\BDD\IndiaTest  or  \\192.168.11.142\BDD\IndiaTest" Text="{Binding DataFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseDataFolderCommand}"
                                Content="Browse…"
                                Icon="{ui:SymbolIcon Folder24}" />
                        </Grid>
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource CaptionText}"
                            Text="Used as the working folder for every operation while connected: CREATE / ALTER / DROP TABLE, CREATE INDEX, INSERT, UPDATE, DELETE, SELECT and the explorer. The HFSQL ODBC driver reads and writes table files (.fic/.ndx/.mmo) relative to this folder. Point it at the database folder of the HFSQL server: a local path when the app runs on the server, or a network share path from another PC (needs write access). Leave empty to use the app's folder." />
                    </StackPanel>
                </Border>

                <!--  Test result  -->
                <Border Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style BasedOn="{StaticResource CardBorder}" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,8,0" FontSize="20">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ErrorCircle24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionTitle}"
                                Text="{Binding TestTitle}" />
                        </StackPanel>
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding TestDetail, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Footer  -->
        <Border
            Grid.Row="2"
            Padding="24,16"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding TestConnectionCommand}"
                        Content="Test Connection"
                        Icon="{ui:SymbolIcon PlugConnected24}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <ui:ProgressRing
                        Width="20"
                        Height="20"
                        Margin="12,0,0,0"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button Command="{Binding CancelCommand}" Content="Cancel" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Command="{Binding ConnectCommand}"
                        Content="Connect"
                        Icon="{ui:SymbolIcon Database24}"
                        IsDefault="True"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
